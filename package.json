{
  "name": "prompteque-skazy-formation",
  "version": "1.0.0",
  "private": true,
  "description": "Prompthèque : les techniques de prompt de la rubrique « AI Skill of the Day » de The Neuron, traduites en français et classées, pour les formations Skazy Formation",
  "type": "module",
  "scripts": {
    "dev": "node outils/dev.js",
    "build": "node outils/construire.js",
    "icones": "node outils/generer-icones.js",
    "captures": "node outils/captures.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "html-validate src/index.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run format:check && npm run validate:html && npm run test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check",
    "pre-push": "npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "simple-git-hooks": "^2.14.0",
    "vitest": "^5.0.3"
  }
}
